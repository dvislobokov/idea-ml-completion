    <PackageReference Include="OpenTK" Version="4.9.3" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageDownload Include="Microsoft.WindowsDesktop.App.Ref" Version="[10.0.0]" />
  </ItemGroup>
</Project>
